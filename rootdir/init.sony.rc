service msim_sh /odm/bin/init.qcom.msim.sh
    user root
    group root
    oneshot

on boot
    # Enable smart charging
    wait /sys/class/battchg_ext/smart_charging_activation
    write /sys/class/battchg_ext/smart_charging_activation 1
    chown system system /sys/class/battchg_ext/smart_charging_interruption

    # Set up permission for touch framerate node
    chown system system /sys/devices/virtual/input/lxs_ts_input/frame_rate_np

    # Set up permission for dt2w nodes
    chown system system /sys/devices/virtual/input/lxs_ts_input/enable_knock
    chown system system /sys/devices/dsi_panel_driver/pre_sod_mode

on early-boot
    # BT A2DP offload: vendor.prop alone is overridden by stale /data/property;
    # force defaults before audio-hal / bluetooth start.
    setprop persist.bluetooth.a2dp_offload.disabled false
    setprop persist.bluetooth.a2dp_aac.vbr_supported true

on early-init
    # Xperia phones have no hardware nav keys; must be set before system_server
    # reads DisplayPolicy (qemu.hw.mainkeys empty + missing RRO => no nav bar).
    setprop qemu.hw.mainkeys 0

    # radio
    wait /dev/block/by-name/LTALabel
    exec_start msim_sh

on post-fs
    setprop ro.vendor.ltalabel.model ${vendor.radio.ltalabel.model}

on property:vendor.post_boot.parsed=1
    # IRQ Tuning
    # IRQ 246: msm_drm
    # IRQ 43: kgsl_3d0_irq
    write /proc/irq/246/smp_affinity_list 2
    write /proc/irq/43/smp_affinity_list 1

on property:ro.vendor.ltalabel.model=XQ-DQ44
    setprop ro.vendor.product.rf.id pdx234-J4
    setprop persist.vendor.nfc.config_file_name "libnfc-nxp-typef.conf"

on property:ro.vendor.ltalabel.model=XQ-DQ54
    setprop ro.vendor.product.rf.id pdx234-A4

on property:ro.vendor.ltalabel.model=XQ-DQ62
    setprop ro.vendor.product.rf.id pdx234-A2US

on property:ro.vendor.ltalabel.model=XQ-DQ72
    setprop ro.vendor.product.rf.id pdx234-C2

on property:ro.vendor.ltalabel.model=A301SO
    setprop ro.vendor.product.rf.id pdx234-S4
    setprop persist.vendor.nfc.config_file_name "libnfc-nxp-typef.conf"

on property:ro.vendor.ltalabel.model=SOG10
    setprop ro.vendor.product.rf.id pdx234-K4
    setprop persist.vendor.nfc.config_file_name "libnfc-nxp-typef.conf"

on property:ro.vendor.ltalabel.model=SO-51D
    setprop ro.vendor.product.rf.id pdx234-N4
    setprop persist.vendor.nfc.config_file_name "libnfc-nxp-typef.conf"

on property:ro.vendor.ltalabel.model=XQ-DE44
    setprop ro.vendor.product.rf.id pdx237-J4
    setprop persist.vendor.nfc.config_file_name "libnfc-nxp-typef.conf"

on property:ro.vendor.ltalabel.model=XQ-DE54
    setprop ro.vendor.product.rf.id pdx237-A4

on property:ro.vendor.ltalabel.model=XQ-DE72
    setprop ro.vendor.product.rf.id pdx237-C2

on property:ro.vendor.ltalabel.model=SOG12
    setprop ro.vendor.product.rf.id pdx237-K4
    setprop persist.vendor.nfc.config_file_name "libnfc-nxp-typef.conf"

on property:ro.vendor.ltalabel.model=SO-53D
    setprop ro.vendor.product.rf.id pdx237-N4
    setprop persist.vendor.nfc.config_file_name "libnfc-nxp-typef.conf"

on property:sys.boot_completed=1
    swapon_all /vendor/etc/fstab.zram
    setprop vendor.sony.boot_completed 1

# After audioserver restart, Sony BT offload session (btaudio_offload_if.so) goes
# stale while A2DP still shows connected. Toggle Bluetooth to re-establish it.
on property:init.svc.audioserver=stopped && property:vendor.sony.boot_completed=1
    setprop vendor.sony.bt.refresh_pending 1

on property:init.svc.audioserver=running && property:vendor.sony.bt.refresh_pending=1
    setprop vendor.sony.bt.refresh_pending 0
    start bt-refresh-after-audioserver

service bt-refresh-after-audioserver /vendor/bin/bt_refresh_after_audioserver.sh
    class late_start
    user system
    group bluetooth net_bt_admin
    oneshot
    disabled

on init
    write /sys/kernel/cnss/recovery 1
